# Local analysis artifacts: keep portable graph outputs, ignore machine-local state.
.codegraph/*
!.codegraph/.gitignore
.code-review-graph/*
!.code-review-graph/.gitignore

.ua/*
!.ua/.understandignore
!.ua/config.json
!.ua/fingerprints.json
!.ua/knowledge-graph.json
!.ua/meta.json
!.ua/intermediate/
.ua/intermediate/*
!.ua/intermediate/scan-result.json

graphify-out/*
